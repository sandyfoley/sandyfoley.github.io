---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const [latestPost, ...recentPosts] = posts;
---

<BaseLayout
  title="So you wanna... with AI"
  description="A practical blog for .NET architects and developers using AI in real software delivery."
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">AI as delivery leverage</p>
      <h1>So you wanna build better with AI</h1>
      <p class="hero-copy">
        Practical notes for senior .NET architects and developers using AI to improve real-world
        software architecture, implementation, content workflows, and delivery quality.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/blog/">Read the blog</a>
        <a class="button secondary" href="/about/">About Sandy</a>
      </div>
    </div>
  </section>

  {
    latestPost && (
      <section class="section">
        <div class="container">
          <p class="eyebrow">Latest</p>
          <h2 class="section-heading">Current field note</h2>
          <PostCard post={latestPost} featured />
        </div>
      </section>
    )
  }

  <section class="section audience">
    <div class="container audience-grid">
      <div>
        <p class="eyebrow">Who this is for</p>
        <h2 class="section-heading">Architects and developers doing the work</h2>
      </div>
      <p>
        This blog is for .NET developers and architects working on content-driven platforms,
        delivery pipelines, integrations, and long-lived systems where AI needs to fit into
        practical engineering habits.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Recent posts</p>
      <h2 class="section-heading">Useful notes, not AI theater</h2>
      <p class="section-intro">
        Codex workflows, prompt strategy, in-app browser usage, context management, and applying AI
        to the messy parts of software delivery.
      </p>
      <div class="post-grid">
        {(recentPosts.length > 0 ? recentPosts : posts).slice(0, 3).map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--subtle);
    background:
      linear-gradient(135deg, rgba(18, 54, 61, 0.06), rgba(37, 99, 111, 0.02)),
      var(--surface);
  }

  .hero-inner {
    max-width: 980px;
    padding: 6.2rem 0 5.4rem;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(3rem, 8vw, 6.8rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
  }

  .hero-copy {
    max-width: 760px;
    margin: 1.4rem 0 0;
    color: var(--muted);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--accent);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-weight: 700;
  }

  .button:hover,
  .button:focus-visible {
    text-decoration: none;
  }

  .primary {
    background: var(--accent-strong);
    color: #ffffff;
  }

  .primary:hover,
  .primary:focus-visible {
    background: var(--accent);
    color: #ffffff;
  }

  .secondary {
    background: transparent;
    color: var(--accent-strong);
  }

  .audience {
    border-block: 1px solid var(--subtle);
    background: var(--surface);
  }

  .audience-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2rem;
    align-items: start;
  }

  .audience p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 1.12rem;
  }

  @media (max-width: 760px) {
    .hero-inner {
      padding: 4.2rem 0 3.6rem;
    }

    .audience-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
