---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const date = post.data.publishDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="container post">
    <header class="post-header">
      <p class="eyebrow">Field note</p>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      {
        post.data.audience.length > 0 && (
          <ul class="audience-list" aria-label="Intended audience">
            {post.data.audience.map((audience) => (
              <li>{audience}</li>
            ))}
          </ul>
        )
      }
      <div class="meta">
        <time datetime={post.data.publishDate.toISOString()}>{date}</time>
        {
          post.data.tags.length > 0 && (
            <ul class="tag-list" aria-label="Post tags">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
    </header>
    <div class="content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding: 4rem 0 5rem;
  }

  .post-header {
    max-width: 820px;
    border-bottom: 1px solid var(--subtle);
    padding-bottom: 2rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .description {
    margin: 1.1rem 0 0;
    color: var(--muted);
    font-size: clamp(1.1rem, 2vw, 1.25rem);
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .audience-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .audience-list li {
    border: 1px solid rgba(37, 99, 111, 0.3);
    border-radius: 999px;
    background: rgba(37, 99, 111, 0.08);
    padding: 0.22rem 0.65rem;
    color: var(--accent-strong);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .tag-list {
    margin: 0;
  }

  .content {
    max-width: 780px;
    margin-top: 2.4rem;
    font-size: 1.05rem;
  }

  .content :global(h2) {
    margin: 2.25rem 0 0.75rem;
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .content :global(h3) {
    margin: 1.8rem 0 0.45rem;
    font-size: 1.2rem;
  }

  .content :global(p),
  .content :global(ul),
  .content :global(ol) {
    color: #2f3a45;
  }

  .content :global(blockquote) {
    margin: 1.6rem 0;
    border-left: 4px solid var(--accent);
    padding-left: 1rem;
    color: var(--muted);
  }

  .content :global(figure) {
    margin: 1.8rem 0;
  }

  .content :global(figure img) {
    width: 100%;
    border: 1px solid var(--subtle);
    border-radius: 8px;
    box-shadow: var(--shadow);
  }

  .content :global(.figure-small) {
    max-width: 33%;
  }

  .content :global(.figure-small img) {
    width: 100%;
  }

  .content :global(figcaption) {
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
