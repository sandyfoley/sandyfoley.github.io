---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const postUrl = `/blog/${post.slug}/`;
const date = post.data.publishDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<article class:list={['post-card', { featured }]}>
  <h3><a href={postUrl}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  {
    post.data.tags.length > 0 && (
      <ul class="tag-list" aria-label="Post tags">
        {post.data.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
  <time datetime={post.data.publishDate.toISOString()}>{date}</time>
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 1.5rem;
  }

  .featured h3 {
    font-size: clamp(1.35rem, 3vw, 1.85rem);
  }

  .featured time {
    align-self: start;
    margin-top: 0.2rem;
    padding-top: 0;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .featured {
      display: flex;
    }
  }
</style>
