---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="So you wanna... with AI home">
      <span>So you wanna...</span>
      <strong>with AI</strong>
    </a>
    <nav aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid rgba(217, 224, 231, 0.85);
    background: rgba(247, 248, 250, 0.9);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
  }

  .brand {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    color: var(--text);
    font-weight: 650;
    line-height: 1.1;
  }

  .brand strong {
    color: var(--accent);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  nav a {
    border-radius: 8px;
    padding: 0.45rem 0.7rem;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
  }

  nav a[aria-current='page'],
  nav a:hover,
  nav a:focus-visible {
    background: var(--surface-muted);
    color: var(--accent-strong);
    text-decoration: none;
  }

  @media (max-width: 560px) {
    .header-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
